APP_PORT=8080
APP_URL=http://localhost:8080
APP_DEBUG=0
# development = one DB for all roles.
# local_school = admin/clerk only; online_portal = teacher/guardian only.
# hybrid_role_routed = one portal, admin/clerk local DB, teacher/guardian Supabase DB.
APP_DEPLOYMENT_MODE=hybrid_role_routed

POSTGRES_DB=agape_iis
POSTGRES_USER=agape
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=54320

# App database connection.
# Offline/local mode: keep these defaults so the app uses the Docker Postgres service.
DB_HOST=db
DB_PORT=5432
DB_NAME=agape_iis
DB_USER=agape
DB_PASS=change_this_local_password
DB_SSLMODE=disable

# Online/Supabase mode: replace the DB_* values above with your Supabase
# Transaction Pooler settings, usually port 6543 and sslmode=require.
# DB_HOST=aws-1-region.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.your-project-ref
# DB_PASS=your_supabase_db_password
# DB_SSLMODE=require

# Optional, used by Supabase REST/storage integrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key
SUPABASE_STORAGE_BUCKET=enrollment-documents

# local = files stay in ./uploads; supabase = files upload to Supabase Storage.
# Use supabase only when SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and
# SUPABASE_STORAGE_BUCKET are filled; otherwise uploads safely use local storage.
ENROLLMENT_DOCUMENT_STORAGE_DRIVER=local

# Remote Supabase database connection used by offline sync scripts.
# Keep these filled even when DB_* points to the local Docker database.
SUPABASE_DB_HOST=aws-1-region.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASS=your_supabase_db_password
SUPABASE_DB_SSLMODE=require
